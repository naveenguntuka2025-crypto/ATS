# Postgres is required (web app + the mass-email worker run as separate
# processes and need a real shared database, not a local file). Easiest local
# option: `docker compose up -d` (see docker-compose.yml), which gives you
# this exact URL out of the box. Otherwise point it at any local/managed
# Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ats_app"

# Secret used to sign session JWTs — set a long random string in production
AUTH_SECRET="change-this-to-a-long-random-string"

# Redis, for the mass-email background queue (see lib/queue/, workers/email-worker.ts).
# `docker compose up -d` also starts Redis on this URL. Requires running
# `npm run worker:email` in a separate process alongside `npm run dev` /
# `npm run start` for queued campaigns to actually send.
REDIS_URL="redis://localhost:6379"
